# App Configuration
APP_NAME=Ponnostack
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=my_ecommerce_db
DB_USERNAME=root
DB_PASSWORD=

# Security / Token Secret
JWT_SECRET=change-this-to-a-secure-random-key-in-production

# Storage / Uploads
UPLOAD_DIR=uploads

# Payment Gateway / Universal bKash
UNIVERSAL_BKASH=01642956206
BKASH_ACCOUNT_TYPE=Personal (Send Money)

# Mail / SMTP Configuration
MAIL_MAILER=smtp
MAIL_HOST=mail.ponnostack.shop
MAIL_PORT=465
MAIL_USERNAME=support@ponnostack.shop
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@ponnostack.shop
MAIL_FROM_NAME="PonnoStack"
