# =======================================================================
# Ponnostack Platform - Enterprise Web Server Configuration
# 1. 100% Clean Route Enforcement (Zero .php / Zero index.php in URLs)
# 2. 301 Canonical SEO Redirections for Duplicate Content Elimination
# 3. Gzip / Deflate Compression (mod_deflate)
# 4. Long-Term Browser Caching (mod_expires)
# 5. Security Headers (mod_headers)
# Target: 95-100/100 Google Lighthouse SEO & Top Crawler Rank
# =======================================================================

# CHARACTER ENCODING & LANGUAGE
AddDefaultCharset UTF-8
DefaultLanguage bn

# -----------------------------------------------------------------------
# REWRITE ENGINE & CLEAN CANONICAL ROUTING (LOCALHOST & PONNOSTACK.SHOP)
# -----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------------------
    # PRODUCTION (https://ponnostack.shop/) ENFORCEMENTS
    # -------------------------------------------------------------------
    # 1. Redirect www.ponnostack.shop to canonical non-www https://ponnostack.shop/
    RewriteCond %{HTTP_HOST} ^www\.ponnostack\.shop$ [NC]
    RewriteRule ^(.*)$ https://ponnostack.shop/$1 [R=301,L]

    # 2. Direct index.php removal on production -> /
    RewriteCond %{HTTP_HOST} ^(?:www\.)?ponnostack\.shop$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php(?:\?([^\s]*))?\s [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # 3. Direct .php extension removal on production (excludes backend/)
    RewriteCond %{HTTP_HOST} ^(?:www\.)?ponnostack\.shop$ [NC]
    RewriteCond %{REQUEST_URI} !^/backend/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([a-zA-Z0-9_-]+)\.php(?:\?([^\s]*))?\s [NC]
    RewriteRule ^ %1 [R=301,L]

    # -------------------------------------------------------------------
    # LOCALHOST (c:/xampp/htdocs/Ponnostack) ENFORCEMENTS
    # -------------------------------------------------------------------
    # 5. Direct index.php removal on localhost -> /Ponnostack/
    RewriteCond %{HTTP_HOST} localhost [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/Ponnostack/index\.php(?:\?([^\s]*))?\s [NC]
    RewriteRule ^index\.php$ /Ponnostack/ [R=301,L]

    # 6. Direct .php extension removal on localhost (excludes backend/)
    RewriteCond %{HTTP_HOST} localhost [NC]
    RewriteCond %{REQUEST_URI} !^/Ponnostack/backend/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/Ponnostack/([a-zA-Z0-9_-]+)\.php(?:\?([^\s]*))?\s [NC]
    RewriteRule ^ /Ponnostack/%1 [R=301,L]

    # -------------------------------------------------------------------
    # FILE HANDLING & INTERNAL CLEAN ROUTING
    # -------------------------------------------------------------------
    # 7. Pass-through for real existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 8. Internally rewrite clean extensionless URL to .php file
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]
</IfModule>

# -----------------------------------------------------------------------
# GZIP / DEFLATE COMPRESSION (mod_deflate)
# -----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# -----------------------------------------------------------------------
# BROWSER CACHING & EXPIRATION (mod_expires)
# -----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML Document (revalidate frequently)
    ExpiresByType text/html "access plus 1 hour"
    
    # Static Assets (1 Year Cache for 100/100 PageSpeed)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------------
# HTTP SECURITY HEADERS (mod_headers)
# -----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------
# SECURITY: PREVENT ACCESS TO SENSITIVE DOT FILES & SQL EXPORTS
# -----------------------------------------------------------------------
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
<Files "database.sql">
    Order allow,deny
    Deny from all
</Files>
