DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirect www.ponnostack.shop to non-www
    RewriteCond %{HTTP_HOST} ^www\.ponnostack\.shop$ [NC]
    RewriteRule ^(.*)$ https://ponnostack.shop/$1 [R=301,L]

    # 2. Redirect direct browser requests to index.php to canonical root
    # Production:
    RewriteCond %{HTTP_HOST} ^(?:www\.)?ponnostack\.shop$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php(?:\?([^\s]*))?\s [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Localhost:
    RewriteCond %{HTTP_HOST} localhost [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/Ponnostack/index\.php(?:\?([^\s]*))?\s [NC]
    RewriteRule ^index\.php$ /Ponnostack/ [R=301,L]

    # 3. Serve real existing files directly (images, css, js, robots.txt, sitemap.xml)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Clean extensionless URLs (e.g. /about -> about.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]

    # 5. Fallback root / and any non-file request directly to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
